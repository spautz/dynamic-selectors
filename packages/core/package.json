{
  "name": "@dynamic-selectors/core",
  "version": "1.2.1",
  "description": "Dynamic selector functions",
  "keywords": [
    "dynamic selector",
    "parameterized selector",
    "selectors",
    "reselect arguments",
    "reselect",
    "memoize",
    "selector functions"
  ],
  "license": "MIT",
  "homepage": "https://github.com/spautz/dynamic-selectors/blob/main/packages/core#readme",
  "bugs": "https://github.com/spautz/dynamic-selectors/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spautz/dynamic-selectors.git",
    "directory": "packages/core"
  },
  "author": {
    "name": "Steven Pautz",
    "url": "https://stevenpautz.com"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "files": [
    "dist/",
    "docs/",
    "src/",
    "LICENSE",
    "*.md"
  ],
  "source": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "local-dev": "./src/index.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "____ HOOKS _________________________________________________________": "",
    "TODO_prepack": "pnpm run clean && turbo run build",
    "prepare": "pnpm run build:lib",
    "prepack": "pnpm run clean && pnpm run build",
    "postpack": "pnpm run build:verifypack",
    "____ STANDARD PACKAGE TASKS ________________________________________": "",
    "TODO_all": "turbo run pipeline-all",
    "TODO_all:ci": "turbo run pipeline-ci --ui=stream",
    "all": "pnpm run format                 && pnpm run typecheck && pnpm run lint:fix && pnpm run test:coverage && pnpm run build",
    "all:readonly": "pnpm run format:verify && pnpm run typecheck && pnpm run lint     && pnpm run test:quick",
    "all:quick": "pnpm run format           && pnpm run typecheck && pnpm run lint:fix",
    "all:ci": "pnpm run format:verify       && pnpm run typecheck && pnpm run lint     && pnpm run test:ci && pnpm run build",
    "build": "pnpm run build:clean && pnpm run build:lib && pnpm run build:verify",
    "clean": "pnpm run \"/^.*:clean$/\" && rimraf --glob ./node_modules/.cache ./.turbo ./*.log",
    "dev": "pnpm run build:lib:watch",
    "TODO_lint": "biome check --write .",
    "lint:verify": "biome check .",
    "publish:yalc": "pnpm run prepack && yalc publish --no-scripts --sig --push --replace",
    "test:clean": "rimraf ./coverage",
    "test": "pnpm run test:clean       && vitest run --coverage",
    "test:ci": "pnpm run test:clean    && vitest run --coverage --bail 1",
    "test:ui": "pnpm run test:clean    && vitest --ui",
    "test:watch": "pnpm run test:clean && vitest watch --coverage",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "____ BUILD & VALIDATION TASKS ______________________________________": "",
    "build:clean": "rimraf --glob ./dist ./*.tgz",
    "build:lib": "tsdown --config ./tsdown.config.ts",
    "build:lib:watch": "tsdown --config ./tsdown.config.ts --watch",
    "build:verify": "publint --strict && size-limit",
    "build:verifypack": "node --experimental-strip-types ../../scripts/verify-packed-tarballs.ts",
    "size-check": "size-limit --why",
    "____ TODO: legacy / to-be-refactored _______________________________": "",
    "format": "prettier --write .",
    "format:verify": "prettier --list-different .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix"
  },
  "dependencies": {
    "lodash-es": "^4.17.21",
    "shallowequal": "^1.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:packages",
    "@size-limit/esbuild": "catalog:packages",
    "@size-limit/esbuild-why": "catalog:packages",
    "@size-limit/file": "catalog:packages",
    "@testing-library/jest-dom": "catalog:shared",
    "@testing-library/react": "catalog:shared",
    "@types/lodash-es": "4.17.12",
    "@types/node": "catalog:packages",
    "@types/shallowequal": "1.1.1",
    "@vitest/coverage-v8": "catalog:shared",
    "@vitest/ui": "catalog:shared",
    "publint": "catalog:packages",
    "size-limit": "catalog:packages",
    "tsdown": "catalog:packages"
  },
  "peerDependencies": {},
  "size-limit": [
    {
      "path": "dist/index.js",
      "import": "{}",
      "limit": "20 B"
    },
    {
      "path": "dist/index.js",
      "limit": "5 kB"
    }
  ]
}
